{
  "name": "pid-to-dexpi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "P&ID (PDF) -> DEXPI + databases pipeline met React UI, geïnspireerd op de Corvic 'P&ID Read' playbook",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm:server\" \"npm:web\"",
    "server": "tsx watch --clear-screen=false server/index.ts",
    "web": "vite",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "pipeline": "tsx server/cli.ts",
    "typecheck": "tsc --noEmit",
    "redexpi": "tsx server/redexpi.ts",
    "recheck": "tsx server/recheck.ts",
    "reconnect": "tsx server/reconnect.ts",
    "score": "tsx server/score.ts",
    "vectorcheck": "tsx server/vectorcheck.ts",
    "compare": "tsx server/compare.ts",
    "overlay": "tsx server/overlay.ts",
    "ab": "tsx server/ab.ts",
    "loss": "tsx server/loss.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vite": "^8.3.8"
  }
}
